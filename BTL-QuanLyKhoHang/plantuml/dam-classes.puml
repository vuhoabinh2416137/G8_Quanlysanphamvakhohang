@startuml dam-classes
!theme plain
skinparam classAttributeIconSize 0
skinparam classFontSize 11
skinparam defaultFontName "Arial"

title Thiết kế Các Lớp Quản lý Truy cập Dữ liệu (Data Access Management - DAM / DAO)\nTheo chuẩn mẫu mã nguồn IT3120 HUST

package "Tầng Quản trị Kết nối (Connection Management)" #ECEFF1 {
    interface DataSource {
        + getConnection(): Connection
    }

    class DatabaseConfig {
        - jdbcUrl: String
        - username: String
        - passwordHash: String
        - maxPoolSize: Integer
        + getDataSource(): DataSource
    }
}

package "Các Lớp Data Access Management (DAM)" #E0F7FA {
    abstract class AbstractDAM<T, ID> {
        # dataSource: DataSource
        + AbstractDAM(dataSource: DataSource)
        # getConnection(): Connection
        # mutedClose(c: Connection, s: Statement, r: ResultSet): void
        + {abstract} getAll(): Stream<T>
        + {abstract} getById(id: ID): Optional<T>
        + {abstract} add(entity: T): Boolean
        + {abstract} update(entity: T): Boolean
        + {abstract} delete(entity: T): Boolean
        # {abstract} createEntity(rs: ResultSet): T
    }

    class VatTuDAM extends AbstractDAM {
        + getAll(): Stream<VatTu>
        + getById(maVT: String): Optional<VatTu>
        + getByDanhMuc(maDanhMuc: String): Stream<VatTu>
        + getVatTuCanhBaoTonThap(): Stream<VatTu>
        + add(vt: VatTu): Boolean
        + update(vt: VatTu): Boolean
        + delete(vt: VatTu): Boolean
        # createEntity(rs: ResultSet): VatTu
    }

    class TonKhoDAM extends AbstractDAM {
        + getAll(): Stream<TonKho>
        + getById(maKho_maVT: CompositeKey): Optional<TonKho>
        + getTonKhoByKho(maKho: String): Stream<TonKho>
        + tangSoLuong(maKho: String, maVT: String, delta: Integer): Boolean
        + giamSoLuong(maKho: String, maVT: String, delta: Integer): Boolean
        + add(tk: TonKho): Boolean
        + update(tk: TonKho): Boolean
        + delete(tk: TonKho): Boolean
        # createEntity(rs: ResultSet): TonKho
    }

    class PhieuNhapKhoDAM extends AbstractDAM {
        + getAll(): Stream<PhieuNhapKho>
        + getById(maPhieu: String): Optional<PhieuNhapKho>
        + getByKho(maKho: String): Stream<PhieuNhapKho>
        + getByLyDoNhap(lyDo: LyDoNhap): Stream<PhieuNhapKho>
        + add(pnk: PhieuNhapKho): Boolean
        + update(pnk: PhieuNhapKho): Boolean
        + delete(pnk: PhieuNhapKho): Boolean
        - loadMucNhap(maPhieu: String): List<MucNhap>
        - saveMucNhap(maPhieu: String, mucNhap: MucNhap, conn: Connection): void
        # createEntity(rs: ResultSet): PhieuNhapKho
    }

    class PhieuXuatKhoDAM extends AbstractDAM {
        + getAll(): Stream<PhieuXuatKho>
        + getById(maPhieu: String): Optional<PhieuXuatKho>
        + getByKho(maKho: String): Stream<PhieuXuatKho>
        + getByLyDoXuat(lyDo: LyDoXuat): Stream<PhieuXuatKho>
        + getByPhongBan(maPB: String): Stream<PhieuXuatKho>
        + add(pxk: PhieuXuatKho): Boolean
        + update(pxk: PhieuXuatKho): Boolean
        + delete(pxk: PhieuXuatKho): Boolean
        - loadMucXuat(maPhieu: String): List<MucXuat>
        - saveMucXuat(maPhieu: String, mucXuat: MucXuat, conn: Connection): void
        # createEntity(rs: ResultSet): PhieuXuatKho
    }

    class YeuCauCapPhatDAM extends AbstractDAM {
        + getAll(): Stream<YeuCauCapPhat>
        + getById(maYeuCau: String): Optional<YeuCauCapPhat>
        + getByTrangThai(trangThai: String): Stream<YeuCauCapPhat>
        + getByPhongBan(maPB: String): Stream<YeuCauCapPhat>
        + add(yc: YeuCauCapPhat): Boolean
        + update(yc: YeuCauCapPhat): Boolean
        + delete(yc: YeuCauCapPhat): Boolean
        # createEntity(rs: ResultSet): YeuCauCapPhat
    }

    class PhongBanDAM extends AbstractDAM {
        + getAll(): Stream<PhongBan>
        + getById(maPB: String): Optional<PhongBan>
        + add(pb: PhongBan): Boolean
        + update(pb: PhongBan): Boolean
        + delete(pb: PhongBan): Boolean
        # createEntity(rs: ResultSet): PhongBan
    }

    class PhienKiemKeDAM extends AbstractDAM {
        + getAll(): Stream<PhienKiemKe>
        + getById(maPhien: String): Optional<PhienKiemKe>
        + getPhienDangThucHien(maKho: String): Optional<PhienKiemKe>
        + add(pkk: PhienKiemKe): Boolean
        + update(pkk: PhienKiemKe): Boolean
        + delete(pkk: PhienKiemKe): Boolean
        # createEntity(rs: ResultSet): PhienKiemKe
    }

    class TaiKhoanDAM extends AbstractDAM {
        + getAll(): Stream<TaiKhoan>
        + getById(tenDangNhap: String): Optional<TaiKhoan>
        + getByNhanVien(maNV: String): Optional<TaiKhoan>
        + add(tk: TaiKhoan): Boolean
        + update(tk: TaiKhoan): Boolean
        + delete(tk: TaiKhoan): Boolean
        # createEntity(rs: ResultSet): TaiKhoan
    }
}

AbstractDAM ..> DataSource : uses
@enduml