@startuml package-diagram
!theme plain
skinparam packageStyle rectangle
skinparam componentStyle uml2
skinparam defaultFontName "Arial"

title Sơ đồ Gói (Package Diagram) - Kiến trúc Phân tầng Hệ thống Quản lý Kho hàng & Vật tư Nội bộ

package "Tầng Giao diện Người dùng (HCI - Human-Computer Interaction)" #FFFDE7 {
    package "com.warehouse.ui.web" {
        class DashboardView
        class VatTuView
        class NhapKhoView
        class XuatKhoView
        class YeuCauCapPhatView
        class KiemKeView
        class BaoCaoView
    }
    
    package "com.warehouse.ui.controller" {
        class VatTuController
        class NhapKhoController
        class XuatKhoController
        class YeuCauCapPhatController
        class KiemKeController
        class AuthController
    }
}

package "Tầng Miền Nghiệp vụ (PD - Problem Domain)" #E8F5E9 {
    package "com.warehouse.service" {
        interface VatTuService
        interface NhapKhoService
        interface XuatKhoService
        interface YeuCauCapPhatService
        interface KiemKeService
        interface TonKhoService
        interface AuthService
    }

    package "com.warehouse.domain.material" {
        class VatTu
        class DanhMuc
    }

    package "com.warehouse.domain.inventory" {
        class Kho
        class ViTriKho
        class TonKho
        class PhieuNhapKho
        class MucNhap
        class PhieuXuatKho
        class MucXuat
        class PhienKiemKe
        class MucKiemKe
    }

    package "com.warehouse.domain.allocation" {
        class YeuCauCapPhat
        class ChiTietYeuCau
        class PhongBan
    }

    package "com.warehouse.domain.identity" {
        class NhanVien
        class TaiKhoan
        class VaiTro
        class Quyen
    }
}

package "Tầng Quản lý Dữ liệu (DM - Data Management)" #E3F2FD {
    package "com.warehouse.dam" {
        interface GenericDAM<T, ID>
        class VatTuDAM
        class TonKhoDAM
        class PhieuNhapKhoDAM
        class PhieuXuatKhoDAM
        class YeuCauCapPhatDAM
        class PhongBanDAM
        class PhienKiemKeDAM
        class TaiKhoanDAM
    }

    package "com.warehouse.db" {
        class DatabaseConnectionPool
        class TransactionManager
    }
}

package "Tầng Hạ tầng & Tích hợp ngoài (PA - Physical Architecture)" #F3E5F5 {
    package "com.warehouse.infrastructure.mail" {
        class EmailService
    }
    
    package "com.warehouse.infrastructure.security" {
        class JwtTokenProvider
        class PasswordEncoder
    }
}

package "Tầng Nền tảng (Foundation Layer)" #ECEFF1 {
    package "com.warehouse.foundation.exception" {
        class BusinessException
        class ResourceNotFoundException
        class InsufficientStockException
    }

    package "com.warehouse.foundation.util" {
        class DateUtils
        class ValidationUtils
        class BarcodeGenerator
    }
}

' Quan hệ phụ thuộc giữa các tầng
"com.warehouse.ui.web" ..> "com.warehouse.ui.controller" : calls
"com.warehouse.ui.controller" ..> "com.warehouse.service" : delegates to

"com.warehouse.service" ..> "com.warehouse.domain.material" : uses
"com.warehouse.service" ..> "com.warehouse.domain.inventory" : uses
"com.warehouse.service" ..> "com.warehouse.domain.allocation" : uses
"com.warehouse.service" ..> "com.warehouse.domain.identity" : uses

"com.warehouse.service" ..> "com.warehouse.dam" : uses
"com.warehouse.service" ..> "com.warehouse.infrastructure.mail" : sends notification
"com.warehouse.service" ..> "com.warehouse.infrastructure.security" : authenticates

"com.warehouse.dam" ..> "com.warehouse.db" : manages connection
"com.warehouse.dam" ..> "com.warehouse.domain.inventory" : maps entities
"com.warehouse.dam" ..> "com.warehouse.domain.material" : maps entities
"com.warehouse.dam" ..> "com.warehouse.domain.allocation" : maps entities

"com.warehouse.service" ..> "com.warehouse.foundation.exception" : throws
"com.warehouse.service" ..> "com.warehouse.foundation.util" : uses

@enduml