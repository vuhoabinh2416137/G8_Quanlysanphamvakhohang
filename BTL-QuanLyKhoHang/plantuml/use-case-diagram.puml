@startuml use-case-diagram
!theme plain
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
    BackgroundColor #F5F5DC
    BorderColor #2F4F4F
    ArrowColor #2F4F4F
}
skinparam actor {
    BackgroundColor #87CEEB
}
skinparam defaultFontName "Arial"

title Biểu đồ Ca sử dụng Tổng quan\nHệ thống Quản lý Kho hàng và Vật tư Nội bộ Tổ chức

' ===== ACTORS =====
actor "Quản trị viên\n(Admin)" as Admin
actor "Quản lý kho\n(Warehouse Manager)" as WM
actor "Đại diện Phòng ban\n(Department Staff)" as DS
actor "Nhân viên kho\n(Warehouse Staff)" as WS

actor "Hệ thống\nemail" as EmailSys <<System>>

' ===== Generalization giữa các tác nhân =====
Admin --|> WM : <<kế thừa quản trị>>

' ===== SYSTEM BOUNDARY =====
rectangle "Hệ thống Quản lý Kho hàng và Vật tư Nội bộ" {

    ' --- Nhóm 1: Xác thực & Phân quyền ---
    package "Xác thực & Phân quyền" {
        usecase "UC01: Đăng nhập /\nĐăng xuất" as UC01
        usecase "UC02: Phân quyền\nngười dùng" as UC02
    }

    ' --- Nhóm 2: Quản lý Vật tư ---
    package "Quản lý Vật tư" {
        usecase "UC03: Quản lý\nvật tư, thiết bị" as UC03
        usecase "UC04: Quản lý danh mục\nvật tư" as UC04
        usecase "UC05: Tìm kiếm\nvật tư" as UC05
    }

    ' --- Nhóm 3: Quản lý Vận hành Kho ---
    package "Quản lý Vận hành Kho" {
        usecase "UC06: Tạo phiếu\nnhập kho" as UC06
        usecase "UC07: Tạo phiếu\nxuất kho" as UC07
        usecase "UC08: Chuyển kho\nnội bộ" as UC08
        usecase "UC09: Kiểm kê kho" as UC09
        usecase "UC10: Xem tồn kho" as UC10
        usecase "UC11: Cảnh báo\ntồn kho thấp" as UC11
    }

    ' --- Nhóm 4: Quản lý Yêu cầu & Cấp phát ---
    package "Quản lý Yêu cầu & Cấp phát" {
        usecase "UC12: Quản lý\nphòng ban / đơn vị" as UC12
        usecase "UC13: Tạo yêu cầu\ncấp phát vật tư" as UC13
        usecase "UC14: Duyệt yêu cầu\ncấp phát" as UC14
        usecase "UC15: Bàn giao &\ntiếp nhận vật tư" as UC15
    }

    ' --- Nhóm 5: Quản lý Nhân sự ---
    package "Quản lý Nhân sự" {
        usecase "UC16: Quản lý\nnhân viên" as UC16
    }

    ' --- Nhóm 6: Báo cáo Thống kê ---
    package "Báo cáo Thống kê" {
        usecase "UC17: Xem báo cáo\ntồn kho" as UC17
        usecase "UC18: Báo cáo X-N-T\n& cấp phát PB" as UC18
    }
}

' ===== ASSOCIATIONS =====
' --- UC01: Tất cả đăng nhập ---
Admin -- UC01
WM -- UC01
DS -- UC01
WS -- UC01

' --- UC02: Phân quyền ---
Admin -- UC02

' --- Quản lý vật tư ---
WM -- UC03
WM -- UC04
WM -- UC05
DS -- UC05
WS -- UC05

' --- Quản lý kho ---
WS -- UC06
WS -- UC07
WM -- UC08
WM -- UC09
WS -- UC09
WM -- UC10
WS -- UC10
UC11 -- EmailSys

' --- Quản lý yêu cầu & cấp phát ---
WM -- UC12
DS -- UC12
DS -- UC13
WM -- UC14
WS -- UC15
DS -- UC15

' --- Quản lý nhân viên ---
Admin -- UC16

' --- Báo cáo ---
WM -- UC17
Admin -- UC18

' ===== RELATIONSHIPS =====
' Include relationships
UC06 ..> UC10 : <<include>>
UC07 ..> UC10 : <<include>>
UC15 ..> UC07 : <<include>>
UC13 ..> UC12 : <<include>>

' Extend relationships
UC11 ..> UC10 : <<extend>>\n[tồn kho < ngưỡng]
UC08 ..> UC07 : <<extend>>\n[chuyển giữa các kho]

@enduml