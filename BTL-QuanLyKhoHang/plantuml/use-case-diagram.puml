@startuml use-case-diagram
!theme plain
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
    BackgroundColor #F5F5DC
    BorderColor #2F4F4F
    ArrowColor #2F4F4F
}
skinparam actor {
    BackgroundColor #87CEEB
}
skinparam defaultFontName "Arial"

title Biểu đồ 07 Ca sử dụng Cốt lõi (1 Thành viên = 1 Ca sử dụng)\nHệ thống Quản lý Kho hàng và Vật tư Nội bộ Tổ chức

' ===== ACTORS =====
actor "Quản trị viên\n(Admin)" as Admin
actor "Quản lý kho\n(Warehouse Manager)" as WM
actor "Đại diện Phòng ban\n(Department Staff)" as DS
actor "Thủ kho / NV Kho\n(Warehouse Staff)" as WS
actor "Dịch vụ Email\n(SMTP Gateway)" as EmailSys <<System>>

' ===== Generalization =====
Admin --|> WM : <<kế thừa quản trị>>

' ===== SYSTEM BOUNDARY =====
rectangle "Hệ thống Quản lý Kho hàng & Vật tư Nội bộ" {

    ' --- F1. Quản trị hệ thống ---
    package "Phân hệ Quản trị & Bảo mật" {
        usecase "UC01: Quản trị Người dùng\n& Phân quyền RBAC\n(TV1: Vũ Hòa Bình)" as UC01
    }

    ' --- F2. Quản lý Danh mục Vật tư ---
    package "Phân hệ Danh mục & Vật tư" {
        usecase "UC02: Quản lý Danh mục\n& Hồ sơ Vật tư, Thiết bị\n(TV4: Nguyễn Trung Ngân)" as UC02
    }

    ' --- F3. Yêu cầu & Cấp phát ---
    package "Phân hệ Yêu cầu & Cấp phát Phòng ban" {
        usecase "UC03: Lập & Theo dõi Yêu cầu\nCấp phát Vật tư\n(TV2: Lý Công Hiếu)" as UC03
        usecase "UC04: Thẩm định & Phê duyệt\nYêu cầu Cấp phát\n(TV3: Phạm Duy Hiếu)" as UC04
    }

    ' --- F4. Vận hành Kho vận ---
    package "Phân hệ Vận hành Kho vận Nội bộ" {
        usecase "UC05: Quản lý Nhập kho\n& Điều chuyển Vật tư\n(TV5: Hoàng Trọng Đức Anh)" as UC05
        usecase "UC06: Quản lý Xuất kho\n& Bàn giao Cấp phát\n(TV6: Đỗ Duy Đức)" as UC06
    }

    ' --- F5. Kiểm kê & Báo cáo ---
    package "Phân hệ Kiểm kê & Báo cáo Thống kê" {
        usecase "UC07: Kiểm kê Kho hàng\n& Báo cáo Tồn kho Tổng hợp\n(TV7: QA Lead)" as UC07
    }
}

' ===== ASSOCIATIONS =====
' UC01: Admin
Admin -- UC01

' UC02: Quản lý kho
WM -- UC02

' UC03: Đại diện phòng ban
DS -- UC03

' UC04: Quản lý kho thẩm định duyệt
WM -- UC04
UC04 ..> EmailSys : <<gửi email thông báo>>

' UC05: Thủ kho nhập kho & điều chuyển
WS -- UC05
WM -- UC05

' UC06: Thủ kho xuất kho & bàn giao
WS -- UC06
DS -- UC06 : <<ký nhận bàn giao>>
UC06 ..> EmailSys : <<cảnh báo tồn kho thấp>>

' UC07: Quản lý kho kiểm kê & báo cáo
WM -- UC07
WS -- UC07 : <<kiểm đếm thực tế>>

' ===== USE CASE RELATIONSHIPS =====
UC04 ..> UC03 : <<extend>> (khi có yêu cầu chờ duyệt)
UC06 ..> UC04 : <<include>> (căn cứ phiếu yêu cầu đã duyệt)

note bottom of UC01
  * Lưu ý: Không tính ca sử dụng Đăng nhập/Đăng xuất
  * Hệ thống gồm đúng 07 Ca sử dụng nghiệp vụ cốt lõi
  * Phân bổ cân bằng 1-1 cho 07 thành viên trong nhóm
end note

@enduml