@startuml activity-ban-hang
!theme plain
title Biểu đồ Hoạt động: Quy trình Bán hàng và Xuất kho\n(UC17 + UC18 + UC07)

|Nhân viên bán hàng|
start
:Tiếp nhận yêu cầu\nmua hàng từ khách;

:Chọn "Tạo đơn bán hàng";

|Hệ thống|
:Hiển thị biểu mẫu\ntạo đơn bán hàng;

|Nhân viên bán hàng|
:Tìm kiếm và chọn\nkhách hàng;

if (Khách hàng đã có\ntrong hệ thống?) then (Có)
    |Hệ thống|
    :Hiển thị thông tin\nkhách hàng;
else (Không)
    |Nhân viên bán hàng|
    :Tạo khách hàng mới;
    |Hệ thống|
    :Lưu thông tin\nkhách hàng mới;
endif

|Nhân viên bán hàng|
:Chọn kho xuất hàng;

repeat
    :Tìm kiếm và thêm\nsản phẩm vào đơn;
    :Nhập số lượng\nvà đơn giá bán;
    
    |Hệ thống|
    if (Tồn kho đủ?) then (Đủ)
        :Tính thành tiền;
    else (Không đủ)
        :Hiển thị cảnh báo\n"Tồn kho không đủ";
        |Nhân viên bán hàng|
        :Điều chỉnh số lượng\nhoặc chọn kho khác;
    endif
    
    |Nhân viên bán hàng|
repeat while (Thêm sản phẩm?) is (Có)
-> Không;

|Hệ thống|
:Tính tổng tiền,\nthuế, giảm giá;

|Nhân viên bán hàng|
:Chọn phương thức\nthanh toán;

if (Thanh toán online?) then (Có)
    |Hệ thống thanh toán|
    :Xử lý thanh toán;
    if (Thanh toán\nthành công?) then (Thành công)
    else (Thất bại)
        |Nhân viên bán hàng|
        :Chọn phương thức\nthanh toán khác;
    endif
else (Tiền mặt/Công nợ)
    |Nhân viên bán hàng|
    :Ghi nhận thanh toán;
endif

|Nhân viên bán hàng|
:Xác nhận đơn bán hàng;

|Hệ thống|
:Lưu đơn bán hàng\ntrạng thái "Đã xác nhận";

fork
    :Gửi thông báo cho\nNV kho chuẩn bị hàng;
fork again
    :In hóa đơn bán hàng;
end fork

' ========== PHASE XUẤT KHO ==========

|Nhân viên kho|
:Nhận thông báo\nđơn bán hàng mới;
:Chuẩn bị hàng hóa;
:Tạo phiếu xuất kho\ntừ đơn bán hàng;

|Hệ thống|
:Tạo phiếu xuất kho\ntự động từ đơn bán;
:Cập nhật tồn kho\n(giảm số lượng);

if (Tồn kho < ngưỡng?) then (Có)
    :Gửi cảnh báo\ntồn kho thấp;
    |Hệ thống email|
    :Gửi email cảnh báo\ncho Quản lý kho;
else (Không)
endif

|Nhân viên kho|
:Đóng gói và\ngiao hàng;

|Hệ thống|
:Cập nhật trạng thái\nđơn bán "Đã giao";

stop
@enduml
