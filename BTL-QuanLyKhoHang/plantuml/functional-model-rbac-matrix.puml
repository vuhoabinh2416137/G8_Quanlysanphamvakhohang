@startuml functional-model-rbac-matrix
!theme plain
skinparam defaultFontName "Arial"
skinparam backgroundColor #FEFEFE

title Ma trận Phân quyền theo Vai trò (RBAC)\nHệ thống Quản lý Sản phẩm và Kho hàng

skinparam map {
    BackgroundColor #F8F9FA
    FontColor #1a365d
    BorderColor #2F4F4F
}

map "ADMIN" as admin {
    Quản lý nhân viên => ✅
    Phân quyền => ✅
    Quản lý sản phẩm => ✅
    Quản lý danh mục => ✅
