@startuml functional-model-rbac-matrix
!theme plain
skinparam defaultFontName "Arial"
skinparam backgroundColor #FEFEFE

title Ma trận Phân quyền theo Vai trò (RBAC)\nHệ thống Quản lý Kho hàng và Vật tư Nội bộ Tổ chức

skinparam map {
    BackgroundColor #F8F9FA
    FontColor #1a365d
    BorderColor #2F4F4F
}

map "ADMIN" as admin {
    Quản lý nhân viên => ✅
    Phân quyền => ✅
    Quản lý vật tư => ✅
    Quản lý danh mục => ✅
    Tìm kiếm vật tư => ✅
    Tạo phiếu nhập kho => ❌
    Tạo phiếu xuất kho => ❌
    Chuyển kho nội bộ => ❌
    Kiểm kê kho => ❌
    Xem tồn kho => ✅
    Quản lý phòng ban => ✅
    Tạo yêu cầu cấp phát => ❌
    Duyệt yêu cầu cấp phát => ❌
    Bàn giao vật tư => ❌
    Báo cáo tồn kho => ✅
    Báo cáo cấp phát PB => ✅
}

map "QUẢN LÝ KHO" as qlk {
    Quản lý nhân viên => ❌
    Phân quyền => ❌
    Quản lý vật tư => ✅
    Quản lý danh mục => ✅
    Tìm kiếm vật tư => ✅
    Tạo phiếu nhập kho => ❌
    Tạo phiếu xuất kho => ❌
    Chuyển kho nội bộ => ✅
    Kiểm kê kho => ✅
    Xem tồn kho => ✅
    Quản lý phòng ban => ✅
    Tạo yêu cầu cấp phát => ❌
    Duyệt yêu cầu cấp phát => ✅
    Bàn giao vật tư => ❌
    Báo cáo tồn kho => ✅
    Báo cáo cấp phát PB => ✅
}

map "ĐẠI DIỆN PHÒNG BAN" as pb {
    Quản lý nhân viên => ❌
    Phân quyền => ❌
    Quản lý vật tư => ❌
    Quản lý danh mục => ❌
    Tìm kiếm vật tư => ✅
    Tạo phiếu nhập kho => ❌
    Tạo phiếu xuất kho => ❌
    Chuyển kho nội bộ => ❌
    Kiểm kê kho => ❌
    Xem tồn kho => ❌
    Quản lý phòng ban => ❌
    Tạo yêu cầu cấp phát => ✅
    Duyệt yêu cầu cấp phát => ❌
    Bàn giao vật tư (ký nhận) => ✅
    Báo cáo tồn kho => ❌
    Báo cáo cấp phát PB => ❌
}

map "NHÂN VIÊN KHO" as nvk {
    Quản lý nhân viên => ❌
    Phân quyền => ❌
    Quản lý vật tư => ❌
    Quản lý danh mục => ❌
    Tìm kiếm vật tư => ✅
    Tạo phiếu nhập kho => ✅
    Tạo phiếu xuất kho => ✅
    Chuyển kho nội bộ => ❌
    Kiểm kê kho => ✅
    Xem tồn kho => ✅
    Quản lý phòng ban => ❌
    Tạo yêu cầu cấp phát => ❌
    Duyệt yêu cầu cấp phát => ❌
    Bàn giao vật tư (xuất giao) => ✅
    Báo cáo tồn kho => ❌
    Báo cáo cấp phát PB => ❌
}

admin -[hidden]right- qlk
qlk -[hidden]right- pb
pb -[hidden]right- nvk

@enduml
