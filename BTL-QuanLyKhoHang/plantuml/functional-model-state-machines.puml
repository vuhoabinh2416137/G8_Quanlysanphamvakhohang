@startuml functional-model-state-machines
!theme plain
skinparam defaultFontName "Arial"
skinparam backgroundColor #FEFEFE
skinparam state {
    BackgroundColor #E8EAF6
    BorderColor #283593
    FontColor #1a237e
    ArrowColor #283593
}

title Máy trạng thái các Thực thể Nghiệp vụ Chính\nHệ thống Quản lý Sản phẩm và Kho hàng

' ===== Đơn mua hàng =====
state "Đơn Mua Hàng (DonMuaHang)" as DMH {
    [*] --> MOI_TAO : NV mua hàng\ntạo đơn
    MOI_TAO : Trạng thái: MỚI TẠO
    MOI_TAO : Chờ Quản lý kho duyệt

    DA_DUYET : Trạng thái: ĐÃ DUYỆT
    DA_DUYET : PO gửi đến NCC

    TU_CHOI : Trạng thái: TỪ CHỐI
    TU_CHOI : Kèm lý do từ chối

    DA_HUY : Trạng thái: ĐÃ HỦY
    DA_HUY : NV mua hàng hủy

    DANG_GIAO : Trạng thái: ĐANG GIAO
    DANG_GIAO : NCC giao một phần

    DA_NHAN_DU : Trạng thái: ĐÃ NHẬN ĐỦ
    DA_NHAN_DU : Hoàn tất đơn hàng

    MOI_TAO --> DA_DUYET : QLK phê duyệt
    MOI_TAO --> TU_CHOI : QLK từ chối\n(bắt buộc nhập lý do)
    MOI_TAO --> DA_HUY : NV mua hàng hủy
    DA_DUYET --> DANG_GIAO : NCC giao\nmột phần
    DA_DUYET --> DA_NHAN_DU : NCC giao\nđủ 1 lần
    DANG_GIAO --> DA_NHAN_DU : Nhận đủ\ntoàn bộ

    TU_CHOI --> [*]
    DA_HUY --> [*]
    DA_NHAN_DU --> [*]
}

' ===== Phiếu xuất kho =====
state "Phiếu Xuất Kho (PhieuXuatKho)" as PXK {
    [*] --> NHAP_LIEU : NV kho\ntạo phiếu
    NHAP_LIEU : Trạng thái: NHẬP LIỆU
    NHAP_LIEU : Đang nhập thông tin

    DA_XAC_NHAN_PXK : Trạng thái: ĐÃ XÁC NHẬN
    DA_XAC_NHAN_PXK : Tồn kho đã giảm

    DA_HUY_PXK : Trạng thái: ĐÃ HỦY
    DA_HUY_PXK : Không ảnh hưởng tồn kho

    NHAP_LIEU --> DA_XAC_NHAN_PXK : NV kho\nxác nhận
    NHAP_LIEU --> DA_HUY_PXK : NV kho hủy

    DA_XAC_NHAN_PXK --> [*]
    DA_HUY_PXK --> [*]
}

' ===== Sản phẩm =====
state "Sản Phẩm (SanPham)" as SP {
    [*] --> DANG_KD : Thêm SP mới
    DANG_KD : Trạng thái: ĐANG KINH DOANH
    DANG_KD : Cho phép giao dịch

    NGUNG_KD : Trạng thái: NGỪNG KINH DOANH
    NGUNG_KD : Không cho nhập/xuất mới

    DANG_KD --> NGUNG_KD : QLK ngừng\nkinh doanh
    NGUNG_KD --> DANG_KD : QLK kích hoạt lại
}

@enduml
