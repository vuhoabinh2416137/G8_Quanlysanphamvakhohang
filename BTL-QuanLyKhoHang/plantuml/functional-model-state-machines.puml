@startuml functional-model-state-machines
!theme plain
skinparam defaultFontName "Arial"
skinparam backgroundColor #FEFEFE
skinparam state {
    BackgroundColor #E8EAF6
    BorderColor #283593
    FontColor #1a237e
    ArrowColor #283593
}

title Máy trạng thái các Thực thể Nghiệp vụ Chính\nHệ thống Quản lý Kho hàng và Vật tư Nội bộ Tổ chức

' ===== Yêu cầu cấp phát =====
state "Yêu Cầu Cấp Phát (YeuCauCapPhat)" as YCCP {
    [*] --> MOI_TAO : Đại diện PB\ntạo yêu cầu
    MOI_TAO : Trạng thái: MỚI TẠO
    MOI_TAO : Chờ Quản lý kho duyệt

    DA_DUYET : Trạng thái: ĐÃ DUYỆT
    DA_DUYET : Chuyển thông báo đến Thủ kho

    TU_CHOI : Trạng thái: TỪ CHỐI
    TU_CHOI : Kèm lý do từ chối

    DA_HUY : Trạng thái: ĐÃ HỦY
    DA_HUY : Người yêu cầu hủy

    DANG_CAP_PHAT : Trạng thái: ĐANG CẤP PHÁT
    DANG_CAP_PHAT : Thủ kho chuẩn bị xuất kho

    HOAN_THANH : Trạng thái: HOÀN THÀNH
    HOAN_THANH : Ký biên bản bàn giao

    MOI_TAO --> DA_DUYET : QLK phê duyệt
    MOI_TAO --> TU_CHOI : QLK từ chối\n(bắt buộc nhập lý do)
    MOI_TAO --> DA_HUY : Đại diện PB hủy
    DA_DUYET --> DANG_CAP_PHAT : Thủ kho lập phiếu xuất
    DANG_CAP_PHAT --> HOAN_THANH : Phòng ban ký nhận
    
    TU_CHOI --> [*]
    DA_HUY --> [*]
    HOAN_THANH --> [*]
}

' ===== Phiếu xuất kho =====
state "Phiếu Xuất Kho (PhieuXuatKho)" as PXK {
    [*] --> NHAP_LIEU : NV kho\ntạo phiếu
    NHAP_LIEU : Trạng thái: NHẬP LIỆU
    NHAP_LIEU : Đang nhập chi tiết vật tư

    DA_XAC_NHAN_PXK : Trạng thái: ĐÃ XÁC NHẬN
    DA_XAC_NHAN_PXK : Tồn kho đã giảm

    DA_HUY_PXK : Trạng thái: ĐÃ HỦY
    DA_HUY_PXK : Không ảnh hưởng tồn kho

    NHAP_LIEU --> DA_XAC_NHAN_PXK : NV kho\nxác nhận
    NHAP_LIEU --> DA_HUY_PXK : NV kho hủy

    DA_XAC_NHAN_PXK --> [*]
    DA_HUY_PXK --> [*]
}

' ===== Vật tư =====
state "Vật Tư (VatTu)" as VT {
    [*] --> DANG_SD : Thêm VT mới
    DANG_SD : Trạng thái: ĐANG SỬ DỤNG
    DANG_SD : Cho phép cấp phát

    NGUNG_SD : Trạng thái: NGỪNG SỬ DỤNG
    NGUNG_SD : Không cho xuất/cấp phát mới

    DANG_SD --> NGUNG_SD : QLK ngừng\nsử dụng
    NGUNG_SD --> DANG_SD : QLK kích hoạt lại
}

@enduml
