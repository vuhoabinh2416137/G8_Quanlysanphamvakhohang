@startuml state-yeu-cau-cap-phat
!theme plain
skinparam defaultFontName "Arial"
title Sơ đồ Máy Trạng thái: Vòng đời Phiếu Yêu Cầu Cấp Phát Vật Tư (YeuCauCapPhat)

[*] --> MOI_TAO : taoYeuCau()

state MOI_TAO {
    MOI_TAO : entry / khoiTaoYeuCau
    MOI_TAO : do / phongBanChonVatTuVaSoLuong
}

MOI_TAO --> CHO_DUYET : guiYeuCauDuyet() [coItNhat1Muc]
MOI_TAO --> DA_HUY : huyYeuCau()

state CHO_DUYET {
    CHO_DUYET : entry / guiThongBaoDuyetChoQLK
}

CHO_DUYET --> DA_DUYET : duyetCapPhat() [TonKhoKhaDung & DungDinhMuc]
CHO_DUYET --> TU_CHOI : tuChoi(lyDo) / thongBaoTuChoiChoPhongBan()
CHO_DUYET --> DA_HUY : huyYeuCau()

TU_CHOI --> CHO_DUYET : dieuChinhVaGuiLai()
TU_CHOI --> DA_HUY : dongYeuCau()

state DA_DUYET {
    DA_DUYET : entry / thongBaoChoThuKhoVaPhongBan
    DA_DUYET : do / thuKhoChuanBiVatTu
}

DA_DUYET --> DANG_CAP_PHAT : thuKhoXuatKho() / taoPhieuXuat()

state DANG_CAP_PHAT {
    DANG_CAP_PHAT : do / kiemDemVaBanGiaoVatTu
}

DANG_CAP_PHAT --> HOAN_THANH : kyBienBanBanGiao() / truTonKho()
DANG_CAP_PHAT --> DA_HUY : suCoGiaoNhanKhongThanh()

HOAN_THANH --> [*]
DA_HUY --> [*]
@enduml

@startuml state-phieu-xuat-kho
!theme plain
skinparam defaultFontName "Arial"
title Sơ đồ Máy Trạng thái: Vòng đời Phiếu Xuất Kho (PhieuXuatKho)

[*] --> MOI_TAO : taoPhieuXuat()

state MOI_TAO {
    MOI_TAO : entry / khoiTaoPhieuXuat
    MOI_TAO : do / choNVKho_NhapChiTiet
}

MOI_TAO --> DA_HUY : huyPhieu()
MOI_TAO --> CHO_DUYET : guiDuyet() [coItNhat1MucXuat]

state CHO_DUYET {
    CHO_DUYET : entry / guiThongBaoDenQLK
}

CHO_DUYET --> DA_XAC_NHAN : duyetXuatKho() / truTonKho()
CHO_DUYET --> TU_CHOI : tuChoi(lyDo) / thongBaoNVKho()

TU_CHOI --> MOI_TAO : suaLai()
TU_CHOI --> DA_HUY : dongPhieu()

state DA_XAC_NHAN {
    DA_XAC_NHAN : entry / capNhatTonKho_GhiLog
}

DA_XAC_NHAN --> HOAN_THANH : xacNhanGiaoNhan() / kyBienBan()

HOAN_THANH --> [*]
DA_HUY --> [*]
@enduml

@startuml state-san-pham
!theme plain
skinparam defaultFontName "Arial"
title Sơ đồ Máy Trạng thái: Vòng đời Vật tư (VatTu)

[*] --> DU_THAO : taoVatTuMoi()

DU_THAO --> DANG_SU_DUNG : pheDuyetLuuHanh()

state DANG_SU_DUNG {
    SAN_HANG : Sẵn sàng cấp phát trong kho
    TON_THAP : Cảnh báo tồn dưới định mức
    HET_HANG : Hết vật tư trong kho

    [*] --> SAN_HANG : nhapKhoLanDau() [soLuong > nguong]

    SAN_HANG --> TON_THAP : xuatKho() [soLuong <= nguong && soLuong > 0] / guiCanhBao()
    TON_THAP --> SAN_HANG : nhapKho() [soLuong > nguong]
    TON_THAP --> HET_HANG : xuatKho() [soLuong == 0]
    HET_HANG --> SAN_HANG : nhapKho() [soLuong > nguong]
}

DANG_SU_DUNG --> TAM_KHOA_KIEM_KE : batDauKiemKe()
TAM_KHOA_KIEM_KE --> DANG_SU_DUNG : hoanTatKiemKe()

DANG_SU_DUNG --> NGUNG_SU_DUNG : ngungCapPhat() [soLuong == 0]
NGUNG_SU_DUNG --> CHO_THANH_LY : lapBienBanThanhLy()
CHO_THANH_LY --> [*] : hoanTatThanhLy()
@enduml