@startuml domain-class-diagram
!theme plain
skinparam classAttributeIconSize 0
skinparam classFontSize 11
skinparam defaultFontName "Arial"

title Biểu đồ Lớp Mô hình Lĩnh vực (Domain Model)\nHệ thống Quản lý Kho hàng và Vật tư Nội bộ Tổ chức

' ===== NHOM VAT TU =====
package "Quản lý Vật tư" #FFFDE7 {
    class VatTu <<entity>> {
        - maVT: String
        - tenVT: String
        - donViTinh: String
        - quyCach: String
        - nguongTonKho: Integer
        - hinhAnhURL: String
        - trangThai: TrangThaiVT
        --
        + layThongTin(): VatTu
        + capNhat(): void
        + kiemTraTonKho(): Boolean
    }

    class DanhMuc <<entity>> {
        - maDanhMuc: String
        - tenDanhMuc: String
        - moTa: String
        --
        + layDanhSachVatTu(): List<VatTu>
    }

    enum TrangThaiVT {
        DANG_SU_DUNG
        TAM_NGUNG
        NGUNG_SU_DUNG
    }
}

' ===== NHOM KHO HANG =====
package "Quản lý Kho hàng" #E0F0FF {
    class Kho <<entity>> {
        - maKho: String
        - tenKho: String
        - diaChi: String
        - dienThoai: String
        - nguoiQuanLy: NhanVien
        --
        + layTonKho(): List<TonKho>
        + kiemKe(): PhienKiemKe
    }

    class ViTriKho <<entity>> {
        - maViTri: String
        - khuVuc: String
        - ke: String
        - tang: String
        --
        + layTonKho(): Integer
    }

    class TonKho <<entity>> {
        - soLuong: Integer
        - ngayCapNhat: Date
        --
        + tang(soLuong: Integer): void
        + giam(soLuong: Integer): void
        + kiemTraNguong(): Boolean
    }

    class PhieuNhapKho <<entity>> {
        - maPhieu: String
        - ngayNhap: Date
        - lyDoNhap: LyDoNhap
        - nguonNhap: String
        - ghiChu: String
        - trangThai: TrangThaiPhieu
        --
        + xacNhan(): void
        + huyPhieu(): void
    }

    class MucNhap <<entity>> {
        - soLuong: Integer
        - viTriKe: String
        - ghiChu: String
    }

    class PhieuXuatKho <<entity>> {
        - maPhieu: String
        - ngayXuat: Date
        - lyDoXuat: LyDoXuat
        - ghiChu: String
        - trangThai: TrangThaiPhieu
        --
        + xacNhan(): void
        + huyPhieu(): void
    }

    class MucXuat <<entity>> {
        - soLuongYeuCau: Integer
        - soLuongThucXuat: Integer
        - ghiChu: String
    }

    class PhienKiemKe <<entity>> {
        - maPhien: String
        - ngayKiemKe: Date
        - phamVi: String
        - trangThai: TrangThaiKiemKe
        - ghiChu: String
        --
        + taoPhieuDieuChinh(): void
    }

    class MucKiemKe <<entity>> {
        - soLuongHeThong: Integer
        - soLuongThucTe: Integer
        - chenhLech: Integer
        - lyDo: String
        --
        + tinhChenhLech(): Integer
    }

    enum LyDoNhap {
        TIEP_NHAN_PHAN_BO
        THU_HOI_PHONG_BAN
        CHUYEN_KHO_DEN
        CAN_DOI_KIEM_KE
    }

    enum LyDoXuat {
        CAP_PHAT_NOI_BO
        CHUYEN_KHO
        THANH_LY_HUY
        CAN_DOI_KIEM_KE
    }

    enum TrangThaiPhieu {
        MOI_TAO
        DA_XAC_NHAN
        DA_HUY
    }

    enum TrangThaiKiemKe {
        DANG_THUC_HIEN
        HOAN_THANH
        DA_HUY
    }
}

' ===== NHOM YEU CAU & CAP PHAT NOI BO =====
package "Quản lý Yêu cầu & Cấp phát Nội bộ" #E8F5E9 {
    class PhongBan <<entity>> {
        - maPhongBan: String
        - tenPhongBan: String
        - dienThoai: String
        - diaDiem: String
        - moTa: String
        - trangThai: String
        --
        + layDanhSachYeuCau(): List<YeuCauCapPhat>
    }

    class YeuCauCapPhat <<entity>> {
        - maYeuCau: String
        - ngayYeuCau: Date
        - ngayDuyet: Date
        - mucDichSuDung: String
        - ghiChu: String
        - lyDoTuChoi: String
        - trangThai: TrangThaiYeuCau
        --
        + guiYeuCau(): void
        + duyet(): void
        + tuChoi(lyDo: String): void
    }

    class ChiTietYeuCau <<entity>> {
        - soLuongYeuCau: Integer
        - soLuongDuyet: Integer
        - ghiChu: String
    }

    enum TrangThaiYeuCau {
        MOI_TAO
        CHO_DUYET
        DA_DUYET
        TU_CHOI
        DANG_CAP_PHAT
        HOAN_THANH
        DA_HUY
    }
}

' ===== NHOM NHAN VIEN & PHAN QUYEN =====
package "Nhân viên & Phân quyền (RBAC)" #F3E5F5 {
    class NhanVien <<entity>> {
        - maNV: String
        - hoTen: String
        - ngaySinh: Date
        - gioiTinh: String
        - diaChi: String
        - dienThoai: String
        - email: String
        - chucVu: String
        - trangThai: String
        --
        + layThongTin(): NhanVien
    }

    class TaiKhoan <<entity>> {
        - tenDangNhap: String
        - matKhauHash: String
        - trangThai: String
        - lanDangNhapCuoi: Date
        --
        + kiemTraMatKhau(mk: String): Boolean
        + doiMatKhau(mkMoi: String): void
    }

    class VaiTro <<entity>> {
        - maVaiTro: String
        - tenVaiTro: String
        - moTa: String
    }

    class Quyen <<entity>> {
        - maQuyen: String
        - tenQuyen: String
        - moTa: String
    }
}

' ===== RELATIONSHIPS =====
' Danh mục tự quy chiếu
DanhMuc "0..1" -- "*" DanhMuc : chua

' Danh mục - Vật tư
DanhMuc "1" -- "*" VatTu : phan loai

' Kho - Vị trí
Kho "1" *-- "1..*" ViTriKho : co

' Kho - Vật tư thông qua Tồn kho
Kho "1" -- "*" TonKho
VatTu "1" -- "*" TonKho
ViTriKho "0..1" -- "*" TonKho : luu tai

' Phiếu nhập kho
PhieuNhapKho "1" *-- "1..*" MucNhap : chua
MucNhap "*" -- "1" VatTu : nhap vat tu
Kho "1" -- "*" PhieuNhapKho : nhan vao kho
NhanVien "1" -- "*" PhieuNhapKho : nguoi lap
PhongBan "0..1" -- "*" PhieuNhapKho : ban giao

' Phiếu xuất kho
PhieuXuatKho "1" *-- "1..*" MucXuat : chua
MucXuat "*" -- "1" VatTu : xuat vat tu
Kho "1" -- "*" PhieuXuatKho : xuat tu kho
Kho "0..1" -- "*" PhieuXuatKho : chuyen toi kho
NhanVien "1" -- "*" PhieuXuatKho : nguoi lap
PhongBan "0..1" -- "*" PhieuXuatKho : nhan cap phat

' Yêu cầu cấp phát nội bộ
PhongBan "1" -- "*" YeuCauCapPhat : tao yeu cau
YeuCauCapPhat "1" *-- "1..*" ChiTietYeuCau : gom
ChiTietYeuCau "*" -- "1" VatTu : chi dinh vat tu
NhanVien "1" -- "*" YeuCauCapPhat : nguoi yeu cau
NhanVien "0..1" -- "*" YeuCauCapPhat : nguoi phe duyet
YeuCauCapPhat "0..1" -- "0..1" PhieuXuatKho : can cu xuat kho

' Kiểm kê
Kho "1" -- "*" PhienKiemKe : kiem ke tai
PhienKiemKe "1" *-- "1..*" MucKiemKe : gom
MucKiemKe "*" -- "1" VatTu : kiem dem
NhanVien "1" -- "*" PhienKiemKe : thuc hien

' Quản lý kho
NhanVien "1" -- "*" Kho : quan ly

' Nhân viên - Phòng ban
PhongBan "1" -- "*" NhanVien : truc thuoc

' Tài khoản & Phân quyền
NhanVien "1" -- "1" TaiKhoan : so huu
TaiKhoan "*" -- "*" VaiTro : duoc gan
VaiTro "*" -- "*" Quyen : co quyen

@enduml