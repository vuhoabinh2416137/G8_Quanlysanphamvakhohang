@startuml ssd-nhap-kho
!theme plain
autonumber
skinparam responseMessageBelowArrow true
skinparam defaultFontName "Arial"

title Sơ đồ Tuần tự Mức Hệ thống (SSD) - UC06: Tạo Phiếu Nhập Kho Nội bộ

actor "Nhân viên kho" as NV
participant ":Hệ thống" as Sys

NV -> Sys: yeuCauTaoPhieuNhap()
activate Sys
Sys --> NV: hienThiFormNhapKho(danhSachKho, danhSachLyDoNhap)
deactivate Sys

NV -> Sys: chonKhoVaLyDoNhap(maKho, lyDoNhap, nguonGiao)
activate Sys
Sys --> NV: hienThiDanhMucVatTu(dsVatTu)
deactivate Sys

loop Với mỗi vật tư tiếp nhận
    NV -> Sys: nhapMucVatTu(maVT, soLuongThucNhan, viTriKe)
    activate Sys
    Sys --> NV: capNhatDanhSachMucNhap(dsMucHienTai)
    deactivate Sys
end

NV -> Sys: xacNhanHoanTatPhieuNhap(ghiChu)
activate Sys
alt Hợp lệ
    Sys --> NV: thongBaoThanhCong(maPhieuNhap, tangTonKho)
else Lỗi dữ liệu
    Sys --> NV: thongBaoLoi(lyDo)
end
deactivate Sys
@enduml

@startuml ssd-xuat-kho
!theme plain
autonumber
skinparam responseMessageBelowArrow true
skinparam defaultFontName "Arial"

title Sơ đồ Tuần tự Mức Hệ thống (SSD) - UC07: Tạo Phiếu Xuất Kho Nội bộ

actor "Nhân viên kho" as NV
participant ":Hệ thống" as Sys

NV -> Sys: yeuCauTaoPhieuXuat()
activate Sys
Sys --> NV: hienThiFormXuatKho(danhSachKho, danhSachLyDoXuat, dsPhongBan)
deactivate Sys

NV -> Sys: chonKhoVaLyDoXuat(maKho, lyDoXuat, maPhongBanNhan)
activate Sys
Sys --> NV: hienThiDanhSachVatTuTrongKho(dsVatTu, tonKhoKhaDung)
deactivate Sys

loop Với mỗi vật tư xuất cấp phát / chuyển kho
    NV -> Sys: themMucXuat(maVT, soLuongXuat)
    activate Sys
    alt Tồn kho đủ
        Sys --> NV: xacNhanThemMucXuat(dsMucXuatHienTai)
    else Tồn kho không đủ
        Sys --> NV: thongBaoLoiTonKhoKhongDu(soLuongConLai)
    end
    deactivate Sys
end

NV -> Sys: xacNhanXuatKho(ghiChu)
activate Sys
alt Hợp lệ
    Sys --> NV: inPhieuXuatKho(maPXK, giamTonKho)
    opt Tồn kho chạm ngưỡng cảnh báo
        Sys -> Sys: guiCanhBaoTonKhoThap()
    end
else Lỗi
    Sys --> NV: thongBaoLoi(lyDo)
end
deactivate Sys
@enduml

@startuml ssd-yeu-cau-cap-phat
!theme plain
autonumber
skinparam responseMessageBelowArrow true
skinparam defaultFontName "Arial"

title Sơ đồ Tuần tự Mức Hệ thống (SSD) - UC13: Tạo Yêu Cầu Cấp Phát Vật Tư

actor "Đại diện Phòng ban" as DSPB
participant ":Hệ thống" as Sys

DSPB -> Sys: moFormTaoYeuCau()
activate Sys
Sys --> DSPB: hienThiThongTinPhongBanVaDanhMucVT(maPB, dsVatTu)
deactivate Sys

DSPB -> Sys: nhapThongTinYeuCau(mucDichSuDung, ngayCanDung)
activate Sys
Sys --> DSPB: xacNhanThongTinChung()
deactivate Sys

loop Với mỗi vật tư đề xuất cấp phát
    DSPB -> Sys: themMatHangYeuCau(maVT, soLuong)
    activate Sys
    alt Số lượng hợp lệ
        Sys --> DSPB: ghiNhanMucYeuCau(dsMucHienTai)
    else Số lượng <= 0
        Sys --> DSPB: baoLoiSoLuongKhongHopLe()
    end
    deactivate Sys
end

DSPB -> Sys: guiYeuCauCapPhat(ghiChu)
activate Sys
Sys --> DSPB: thongBaoThanhCong(maYeuCau, trangThai = "CHO_DUYET")
Sys -> Sys: guiThongBaoDuyetChoQuanLyKho()
deactivate Sys
@enduml

@startuml ssd-kiem-ke
!theme plain
autonumber
skinparam responseMessageBelowArrow true
skinparam defaultFontName "Arial"

title Sơ đồ Tuần tự Mức Hệ thống (SSD) - UC09: Kiểm Kê Kho

actor "Quản lý / Thủ kho" as NV
participant ":Hệ thống" as Sys

NV -> Sys: taoPhienKiemKe(maKho, phamVi)
activate Sys
Sys --> NV: xacNhanKhoaGiaoDichVaInCountSheet(maPhien, danhSachSP)
deactivate Sys

loop Kiểm đếm thực tế từng mặt hàng
    NV -> Sys: nhapSoLuongKiemDem(maPhien, maSP, soLuongThucTe)
    activate Sys
    Sys --> NV: capNhatKetQuaKiemDem()
    deactivate Sys
end

NV -> Sys: yeuCauBaoCaoChenhLech(maPhien)
activate Sys
Sys --> NV: hienThiBaoCaoChenhLech(dsThuaThieu, tyLeLech)
deactivate Sys

NV -> Sys: xacNhanDieuChinhKho(maPhien, lyDoGiaiTrinh)
activate Sys
Sys --> NV: hoanTatKiemKe(tuDongTaoPhieuDieuChinh, moKhoaGiaoDich)
deactivate Sys
@enduml