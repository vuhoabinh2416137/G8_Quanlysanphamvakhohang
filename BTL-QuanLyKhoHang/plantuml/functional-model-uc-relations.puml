@startuml functional-model-uc-relations
!theme plain
skinparam defaultFontName "Arial"
skinparam backgroundColor #FEFEFE
skinparam packageStyle rectangle

title Quan hệ giữa các Ca sử dụng\nHệ thống Quản lý Kho hàng và Vật tư Nội bộ Tổ chức

skinparam usecase {
    BackgroundColor<<include_src>> #C8E6C9
    BorderColor<<include_src>> #2E7D32

    BackgroundColor<<include_tgt>> #E3F2FD
    BorderColor<<include_tgt>> #1565C0

    BackgroundColor<<extend_src>> #FFF3E0
    BorderColor<<extend_src>> #EF6C00

    BackgroundColor<<extend_tgt>> #FFEBEE
    BorderColor<<extend_tgt>> #C62828

    BackgroundColor<<hub>> #E8EAF6
    BorderColor<<hub>> #283593
}

' ===== Use Cases =====
usecase "UC15: Bàn giao &\ntiếp nhận VT" as UC15 <<include_src>>
usecase "UC06: Tạo phiếu\nnhập kho" as UC06 <<include_src>>
usecase "UC07: Tạo phiếu\nxuất kho" as UC07 <<include_src>>
usecase "UC13: Tạo yêu cầu\ncấp phát vật tư" as UC13 <<include_src>>

usecase "UC10: Xem\ntồn kho" as UC10 <<hub>>
usecase "UC12: Quản lý\nphòng ban" as UC12 <<include_tgt>>

usecase "UC11: Cảnh báo\ntồn kho thấp" as UC11 <<extend_tgt>>
usecase "UC08: Chuyển kho" as UC08 <<extend_tgt>>

' ===== Include Relationships =====
UC15 ..> UC07 : <<include>>\n"Bàn giao kèm\ntạo phiếu xuất"

UC06 ..> UC10 : <<include>>\n"Cập nhật & hiển thị\ntồn kho sau nhập"

UC07 ..> UC10 : <<include>>\n"Kiểm tra tồn kho\ntrước khi xuất"

UC13 ..> UC12 : <<include>>\n"Chọn phòng ban\nkhi tạo yêu cầu"

' ===== Extend Relationships =====
UC11 ..> UC10 : <<extend>>\n[tồn kho < ngưỡng]

UC08 ..> UC07 : <<extend>>\n[xuất chuyển\ngiữa các kho]

' ===== Layout =====
UC15 -[hidden]down- UC07
UC06 -[hidden]down- UC10
UC13 -[hidden]right- UC15

@enduml
